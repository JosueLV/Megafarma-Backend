{
  "info": {
    "name": "Megafarma · Sprint 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Para una nueva entrada borra claveEntrada; para un reintento consérvala."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productoId",
      "value": "1"
    },
    {
      "key": "claveEntrada",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"AdminDemo2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login correcto\", () => pm.response.to.have.status(200));",
              "if(pm.response.code === 200) pm.collectionVariables.set(\"token\",pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Usuario actual",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "03 · Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/productos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"MED-{{$timestamp}}\",\n  \"nombre\": \"Paracetamol 500 mg\",\n  \"presentacion\": \"Tableta\",\n  \"precioVenta\": 0.5,\n  \"stockMinimo\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code === 201) pm.collectionVariables.set(\"productoId\",String(pm.response.json().id));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Buscar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos?buscar=paracetamol",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "05 · Registrar entrada (conservar clave para reintentar)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{claveEntrada}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/entradas",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"referencia\": \"GUIA-001\",\n  \"detalles\": [\n    {\n      \"productoId\": {{productoId}},\n      \"lote\": \"LOTE-DEMO\",\n      \"fechaVencimiento\": \"2030-12-31\",\n      \"cantidad\": 25\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get(\"claveEntrada\")) pm.collectionVariables.set(\"claveEntrada\",pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Stock producto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos/{{productoId}}/stock",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "07 · Lotes del producto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/lotes?productoId={{productoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "08 · Listar entradas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/entradas",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "09 · Cerrar sesión",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/logout",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
